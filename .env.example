# Postgres with the pgvector extension (see docker-compose.yml)
DATABASE_URL=postgres://jarvis:jarvis@localhost:5432/jarvis

# Claude API key, used to answer questions over retrieved passages.
# Search and ingestion work without it.
ANTHROPIC_API_KEY=

# Optional overrides
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=medium            # low | medium | high | xhigh | max
# STORAGE_DIR=./data/storage   # original PDFs and covers
# MODELS_DIR=./models          # local embedding model weights
# EMBEDDING_MODEL=bge-base-en-v1.5
# MAX_UPLOAD_MB=300
