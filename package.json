{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "description": "A private digital library for PDFs with grounded semantic search and question answering.",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "concurrently -k -n web,worker -c gray,yellow \"next dev -H 127.0.0.1\" \"tsx watch scripts/worker.ts\"",
    "build": "next build",
    "start": "concurrently -k -n web,worker -c gray,yellow \"next start -H 127.0.0.1\" \"tsx scripts/worker.ts\"",
    "web": "next dev -H 127.0.0.1",
    "worker": "tsx scripts/worker.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "models:fetch": "tsx scripts/fetch-models.ts",
    "ingest": "tsx scripts/ingest.ts",
    "search": "tsx scripts/search.ts",
    "ask": "tsx scripts/ask.ts",
    "eval:retrieval": "tsx scripts/eval-retrieval.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/core.test.ts",
    "test:integration": "tsx --test tests/ask-loop.test.ts",
    "postinstall": "node scripts/copy-pdf-worker.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@huggingface/transformers": "^4.3.0",
    "@napi-rs/canvas": "^1.0.9",
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.4",
    "next": "^16.3.6",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "pgvector": "^0.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  }
}
