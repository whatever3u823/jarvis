# Postgres. Any provider works (local, Neon, Supabase, Railway…).
DATABASE_URL=postgres://club:club@localhost:5432/club

# Signs the "who is reading" cookie. Any long random string.
CLUB_SECRET=change-me-to-something-long-and-random

# Optional: a word you both know. When set, the threshold asks for it.
# CLUB_PASSPHRASE=
